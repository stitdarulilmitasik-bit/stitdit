RewriteEngine On

# /htdocs/index.php adalah entry point Laravel untuk ByetHost.
RewriteRule ^$ index.php [L]

# Asset/file yang berada di folder /htdocs/public tetap dilayani langsung.
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [L]

# Semua route Laravel lainnya masuk melalui /htdocs/index.php.
RewriteRule ^(.*)$ index.php [L]
